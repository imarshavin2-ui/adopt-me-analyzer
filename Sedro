local function fit()
    local size = root.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    local scale = math.min(1, math.max(0.1, (size.X - 24) / 384), math.max(0.1, (size.Y - 24) / 530))
    local overlapsHUD = size.X / 2 + 192 * scale > size.X - 170
        and (size.Y - 530 * scale) / 2 < 88
    if overlapsHUD then
        scale = math.min(scale, math.max(0.1, (size.Y - 100) / 530))
        panel.Position = UDim2.new(0.5, 0, 0.5, 38)
    else
        panel.Position = UDim2.fromScale(0.5, 0.5)
    end
    panelScale.Scale = scale
end
connect(root:GetPropertyChangedSignal("AbsoluteSize"), fit)
