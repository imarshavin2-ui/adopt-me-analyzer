-- Reversible client-side optimizations; the caller supplies Lighting/Workspace/RunService/Players.
local function newBoostEngine(onStatus)
    local CollectionService = game:GetService("CollectionService")
    local engine, ledger, conflicts = {}, {}, {}
    local generation, changed, errors = 0, 0, 0
    local destroyed, run = false, nil
    local particleClasses = { ParticleEmitter = true, Smoke = true, Fire = true, Sparkles = true }

    local function notify(state)
        if onStatus and not destroyed then
            pcall(onStatus, { state = state, changed = changed, errors = errors })
        end
    end
    local function current(token)
        return not destroyed and token == generation
    end
    local function stopRun()
        if run then
            for _, connection in ipairs(run.connections) do connection:Disconnect() end
            run = nil
        end
    end
    local function block(object, property)
        local properties = conflicts[object]
        if not properties then properties = {}; conflicts[object] = properties end
        properties[property] = true
    end
    local function forget(object, property)
        local properties = ledger[object]
        if properties and properties[property] then
            properties[property] = nil
            changed = math.max(0, changed - 1)
            if next(properties) == nil then ledger[object] = nil end
        end
    end
    local function write(object, property, value)
        if conflicts[object] and conflicts[object][property] then return end
        local ok, existing = pcall(function() return object[property] end)
        if not ok then errors = errors + 1; block(object, property); return end
        local saved = ledger[object] and ledger[object][property]
        if saved and existing ~= saved.applied then
            forget(object, property)
            block(object, property) -- Let the game's newer value win until another Apply.
            return
        end
        if existing == value then return end
        ok = pcall(function() object[property] = value end)
        if not ok then errors = errors + 1; block(object, property); return end
        if not saved then
            saved = { original = existing, applied = value }
            if not ledger[object] then ledger[object] = {} end
            ledger[object][property] = saved
            changed = changed + 1
        else
            saved.applied = value
        end
    end
    local function restore(object, property)
        local saved = ledger[object] and ledger[object][property]
        if not saved then return end
        local ok, existing = pcall(function() return object[property] end)
        if ok and existing == saved.applied then
            ok = pcall(function() object[property] = saved.original end)
        elseif ok then
            block(object, property)
        end
        if not ok then errors = errors + 1 end
        forget(object, property)
    end
    local function restoreAll(token, synchronous)
        local count, started = 0, os.clock()
        while next(ledger) do
            if not synchronous and not current(token) then return false end
            local object, properties = next(ledger)
            restore(object, next(properties))
            count = count + 1
            if not synchronous and (count >= 150 or os.clock() - started > 0.003) then
                task.wait()
                count, started = 0, os.clock()
            end
        end
        return synchronous or current(token)
    end

    local function beginRun(token, options)
        if not current(token) then return end
        local state = {
            connections = {}, queue = {}, pending = {}, head = 1, tail = 0,
            stack = { { items = { Workspace, Lighting }, index = 1 } },
            candidates = {}, candidateSet = {}, candidateIndex = 1,
            positions = {}, moving = {},
            protected = setmetatable({}, { __mode = "k" }),
            overflow = false, scanned = false, lastRescan = os.clock(),
        }
        run = state
        local function protectedMarker(object)
            if object:IsA("ProximityPrompt") or object:IsA("ClickDetector")
                or object:IsA("Humanoid") or object:IsA("Seat") or object:IsA("VehicleSeat") then
                state.protected[object] = true
                local ancestor = object.Parent
                while ancestor and ancestor ~= Workspace do
                    state.protected[ancestor] = true
                    ancestor = ancestor.Parent
                end
            end
        end
        local function enqueue(object)
            if not current(token) or state.pending[object] then return end
            if options.distant then protectedMarker(object) end
            if state.tail - state.head + 1 >= 2048 then
                state.overflow = true -- Revisit the tree after the bounded event queue drains.
                return
            end
            state.tail = state.tail + 1
            state.queue[state.tail] = object
            state.pending[object] = true
        end
        local function nextEvent()
            if state.head > state.tail then return nil end
            local object = state.queue[state.head]
            state.queue[state.head] = nil
            state.pending[object] = nil
            state.head = state.head + 1
            if state.head > state.tail then state.head, state.tail = 1, 0 end
            return object
        end
        local function nextScanned()
            while #state.stack > 0 do
                local frame = state.stack[#state.stack]
                local object = frame.items[frame.index]
                if not object then
                    state.stack[#state.stack] = nil
                else
                    frame.index = frame.index + 1
                    if object.Parent then
                        local children = object:GetChildren()
                        if #children > 0 then
                            state.stack[#state.stack + 1] = { items = children, index = 1 }
                        end
                        return object
                    end
                end
            end
            return nil
        end
        local function process(object)
            if not object.Parent then return end
            if not object:IsDescendantOf(Workspace) and not object:IsDescendantOf(Lighting) then return end
            if options.shadows and object:IsA("Light") then write(object, "Shadows", false) end
            if options.post and (object:IsA("BloomEffect") or object:IsA("SunRaysEffect")) then
                write(object, "Enabled", false)
            end
            if options.distant then
                protectedMarker(object)
                -- Leave additional emitters untouched so nearby effects return promptly.
                if particleClasses[object.ClassName] and not state.candidateSet[object] and #state.candidates < 256 then
                    state.candidates[#state.candidates + 1] = object
                    state.candidateSet[object] = true
                end
            end
        end
        local function hostPart(object)
            local host = object.Parent
            while host and host:IsA("Attachment") do
                if host:IsA("Bone") then return nil end
                host = host.Parent
            end
            if not host or not host:IsA("BasePart") or host:IsA("Terrain") or not host.Anchored then return nil end
            local ancestor = object
            while ancestor and ancestor ~= Workspace do
                if state.protected[ancestor] or ancestor:IsA("Tool")
                    or ancestor:GetAttribute("FPSBoostPreserve") == true
                    or CollectionService:HasTag(ancestor, "FPSBoostPreserve") then return nil end
                if ancestor:IsA("Model") and (Players:GetPlayerFromCharacter(ancestor)
                    or ancestor:FindFirstChildOfClass("Humanoid")) then return nil end
                if ancestor:FindFirstChildOfClass("ProximityPrompt")
                    or ancestor:FindFirstChildOfClass("ClickDetector") then return nil end
                ancestor = ancestor.Parent
            end
            if ancestor ~= Workspace then return nil end
            return host
        end
        local function checkParticles()
            local list = state.candidates
            if #list == 0 then return end
            local camera = Workspace.CurrentCamera
            local player = Players.LocalPlayer
            local character = player and player.Character
            local anchor = character and character:FindFirstChild("HumanoidRootPart")
            if anchor and not anchor:IsA("BasePart") then anchor = nil end
            local started, count, maximum = os.clock(), 0, math.min(60, #list)
            while count < maximum and #list > 0 do
                if state.candidateIndex > #list then state.candidateIndex = 1 end
                local index = state.candidateIndex
                local object = list[index]
                if not object.Parent or not object:IsDescendantOf(Workspace) then
                    restore(object, "Enabled")
                    state.candidateSet[object] = nil
                    state.positions[object], state.moving[object] = nil, nil
                    local last = #list
                    list[index] = list[last]
                    list[last] = nil
                else
                    local host = camera and anchor and hostPart(object)
                    local previous = state.positions[object]
                    local emissionPoint
                    if host then
                        emissionPoint = object.Parent:IsA("Attachment") and object.Parent.WorldPosition or host.Position
                        if previous and (previous.host ~= host or previous.cframe ~= host.CFrame
                            or previous.point ~= emissionPoint) then
                            state.moving[object] = true
                        end
                        state.positions[object] = { host = host, cframe = host.CFrame, point = emissionPoint }
                    end
                    if not host or not previous or state.moving[object] then
                        restore(object, "Enabled")
                    else
                        -- Use the whole host's bounding sphere, not only its center.
                        local radius = host.Size.Magnitude * 0.5
                        local cameraDistance = math.min((camera.CFrame.Position - host.Position).Magnitude - radius,
                            (camera.CFrame.Position - emissionPoint).Magnitude)
                        local playerDistance = math.min((anchor.Position - host.Position).Magnitude - radius,
                            (anchor.Position - emissionPoint).Magnitude)
                        if cameraDistance <= 200 or playerDistance <= 200 then
                            restore(object, "Enabled")
                        elseif cameraDistance > 250 and playerDistance > 250 then
                            write(object, "Enabled", false)
                        end
                    end
                    state.candidateIndex = index + 1
                end
                count = count + 1
                if os.clock() - started > 0.002 then break end
            end
        end

        state.connections[#state.connections + 1] = Workspace.DescendantAdded:Connect(enqueue)
        state.connections[#state.connections + 1] = Lighting.DescendantAdded:Connect(enqueue)
        local function removing(object)
            if not ledger[object] and not conflicts[object] then return end
            task.defer(function()
                if not current(token) then return end
                if not object:IsDescendantOf(Workspace) and not object:IsDescendantOf(Lighting) then
                    local properties = ledger[object]
                    while properties and next(properties) do restore(object, next(properties)) end
                    conflicts[object] = nil
                end
            end)
        end
        state.connections[#state.connections + 1] = Workspace.DescendantRemoving:Connect(removing)
        state.connections[#state.connections + 1] = Lighting.DescendantRemoving:Connect(removing)
        if options.shadows then write(Lighting, "GlobalShadows", false) end
        if options.water then
            local terrain = Workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                write(terrain, "WaterWaveSize", 0)
                write(terrain, "WaterWaveSpeed", 0)
                write(terrain, "WaterReflectance", 0)
            end
        end
        if options.quality then
            local ok, settings = pcall(function() return UserSettings():GetService("UserGameSettings") end)
            if ok then
                local readable, level = pcall(function() return settings.SavedQualityLevel.Value end)
                if readable then
                    if level == 0 or level > 3 then write(settings, "SavedQualityLevel", Enum.SavedQualitySetting.QualityLevel3) end
                else errors = errors + 1 end
            else errors = errors + 1 end
        end
        local lastReport = 0
        while current(token) do
            local started, count = os.clock(), 0
            while count < 150 and os.clock() - started < 0.003 do
                local object = nextScanned()
                local added = nextEvent()
                if not object and not added then break end
                if object then process(object); count = count + 1 end
                if added then process(added); count = count + 1 end
            end
            if #state.stack == 0 then state.scanned = true end
            -- Wait until the first scan has found gameplay markers before touching effects.
            if options.distant and state.scanned then checkParticles() end
            local now = os.clock()
            if state.overflow and #state.stack == 0 and state.head > state.tail and now - state.lastRescan >= 5 then
                state.stack = { { items = { Workspace, Lighting }, index = 1 } }
                state.overflow, state.lastRescan = false, now
            end
            if now - lastReport >= 0.5 then
                notify(state.scanned and "active" or "scanning")
                lastReport = now
            end
            task.wait((#state.stack > 0 or state.head <= state.tail) and 0 or 0.1)
        end
    end

    function engine:Apply(options)
        if destroyed then return end
        generation = generation + 1
        local token = generation
        stopRun()
        errors = 0
        local chosen = {}
        for _, key in ipairs({ "shadows", "post", "water", "distant", "quality" }) do
            chosen[key] = options and options[key] == true
        end
        notify("restoring")
        task.defer(function()
            if not restoreAll(token, false) then return end
            conflicts = {}
            notify("scanning")
            if current(token) then
                if chosen.shadows or chosen.post or chosen.water or chosen.distant or chosen.quality then
                    beginRun(token, chosen)
                else
                    notify("idle")
                end
            end
        end)
    end
    function engine:Reset()
        if destroyed then return end
        generation = generation + 1
        local token = generation
        stopRun()
        errors = 0
        notify("restoring")
        task.defer(function()
            if restoreAll(token, false) then
                conflicts = {}
                notify("idle")
            end
        end)
    end
    function engine:Shutdown()
        if destroyed then return end
        generation = generation + 1
        stopRun()
        restoreAll(generation, true)
        destroyed = true
        conflicts = {}
    end
    return engine
end

engine = newBoostEngine(function(info)
    if not alive then return end
    busy = info.state == "scanning" or info.state == "restoring"
    boost.AutoButtonColor = not busy
    boost.Text = info.state == "scanning" and "ОПТИМИЗАЦИЯ…"
        or (info.state == "restoring" and "ВОССТАНОВЛЕНИЕ…" or "BOOST FPS")
    if dirty and info.state == "active" then return end
    status.TextColor3 = (info.errors or 0) > 0 and C.amber or C.muted
    if info.state == "scanning" then
        status.Text = "Применяю настройки небольшими порциями…"
    elseif info.state == "restoring" then
        status.Text = "Возвращаю изменённые настройки…"
    elseif info.state == "active" then
        status.Text = string.format("Изменено свойств: %d  ·  Ошибок: %d\nBoost активен. Сброс отключает оптимизацию.", info.changed or 0, info.errors or 0)
        if (info.errors or 0) == 0 then status.TextColor3 = C.cyan end
    else
        status.Text = (info.errors or 0) > 0 and "Часть настроек недоступна. Проверь графику в Roblox."
            or "Boost выключен. Выбери опции и нажми BOOST FPS."
    end
end)

connect(boost.Activated, function()
    if busy or not alive then return end
    dirty = false
    local optionsCopy = {}
    for key, value in pairs(selected) do optionsCopy[key] = value end
    engine:Apply(optionsCopy)
end)

connect(reset.Activated, function()
    if not alive then return end
    dirty = false
    engine:Reset()
end)
