local showFPS = true
local function setFPSVisible(visible)
    showFPS = visible
    hud.Visible = visible
    if fpsConnection then
        fpsConnection:Disconnect()
        fpsConnection = nil
    end
    if not visible or not alive then return end
    fpsText.Text = "FPS: —"
    local frames, started = 0, os.clock()
    fpsConnection = RunService.PreRender:Connect(function()
        frames = frames + 1
        local now = os.clock()
        local elapsed = now - started
        if elapsed < 0.5 then return end
        local fps = math.floor(frames / elapsed + 0.5)
        fpsText.Text = "FPS: " .. tostring(fps)
        fpsText.TextColor3 = fps >= 55 and C.cyan or (fps >= 30 and C.amber or Color3.fromRGB(255, 125, 125))
        frames, started = 0, now
    end)
end
